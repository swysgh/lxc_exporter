{
 "kind": "Dashboard",
 "apiVersion": "dashboard.grafana.app/v2",
 "metadata": {},
 "spec": {
  "annotations": [
   {
    "kind": "AnnotationQuery",
    "spec": {
     "query": {
      "kind": "DataQuery",
      "group": "grafana",
      "version": "v0",
      "datasource": {
       "name": "-- Grafana --"
      },
      "spec": {}
     },
     "enable": true,
     "hide": true,
     "iconColor": "rgba(0, 211, 255, 1)",
     "name": "Annotations & Alerts",
     "builtIn": true
    }
   }
  ],
  "cursorSync": "Crosshair",
  "editable": true,
  "elements": {
   "panel-1": {
    "kind": "Panel",
    "spec": {
     "id": 1,
     "title": "运行中的容器",
     "description": "",
     "links": [],
     "data": {
      "kind": "QueryGroup",
      "spec": {
       "queries": [
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "${DS_PROMETHEUS}"
           },
           "spec": {
            "editorMode": "code",
            "expr": "count(lxc_container_up)",
            "legendFormat": "容器数",
            "range": true
           }
          },
          "refId": "A",
          "hidden": false
         }
        }
       ],
       "transformations": [],
       "queryOptions": {}
      }
     },
     "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.2.2",
      "spec": {
       "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
         "calcs": [
          "lastNotNull"
         ],
         "fields": "",
         "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
       },
       "fieldConfig": {
        "defaults": {
         "mappings": [],
         "thresholds": {
          "mode": "absolute",
          "steps": [
           {
            "value": 0,
            "color": "red"
           },
           {
            "value": 1,
            "color": "green"
           }
          ]
         },
         "color": {
          "mode": "thresholds"
         },
         "unit": "short"
        },
        "overrides": []
       }
      }
     }
    }
   },
   "panel-2": {
    "kind": "Panel",
    "spec": {
     "id": 2,
     "title": "容器内存合计",
