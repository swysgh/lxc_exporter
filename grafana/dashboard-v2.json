   "panel-3": {
    "kind": "Panel",
    "spec": {
     "id": 3,
     "title": "CPU 被限流次数（1h）",
     "description": "cgroup 把容器 CPU 掐住的次数，一直涨说明该给容器加配额。",
     "links": [],
     "data": {
      "kind": "QueryGroup",
      "spec": {
       "queries": [
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "${DS_PROMETHEUS}"
           },
           "spec": {
            "editorMode": "code",
            "expr": "sum(round(increase(lxc_container_cpu_nr_throttled_total[1h])))",
            "legendFormat": "限流",
            "range": true
           }
          },
          "refId": "A",
          "hidden": false
         }
        }
       ],
       "transformations": [],
       "queryOptions": {}
      }
     },
     "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.2.2",
      "spec": {
       "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
         "calcs": [
          "lastNotNull"
         ],
         "fields": "",
         "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
       },
       "fieldConfig": {
        "defaults": {
         "mappings": [],
         "thresholds": {
          "mode": "absolute",
          "steps": [
           {
            "value": 0,
            "color": "red"
           },
           {
            "value": 1,
            "color": "green"
           }
          ]
         },
         "color": {
          "mode": "thresholds"
         },
         "unit": "short"
        },
        "overrides": []
       }
      }
     }
    }
   },
   "panel-4": {
    "kind": "Panel",
    "spec": {
     "id": 4,
     "title": "容器概览",
     "description": "容器没设 cgroup 上限（memory.max=max），所以没有「上限/使用率」两列 —— 那两个指标只在设了限制时才上报。",
     "links": [],
     "data": {
      "kind": "QueryGroup",
      "spec": {
       "queries": [
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "${DS_PROMETHEUS}"
           },
           "spec": {
            "editorMode": "code",
            "expr": "lxc_container_memory_bytes",
            "legendFormat": "内存",
            "format": "table",
            "instant": true,
            "range": false
           }
          },
          "refId": "A",
          "hidden": false
         }
        },
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "${DS_PROMETHEUS}"
           },
           "spec": {
            "editorMode": "code",
            "expr": "lxc_container_pids",
            "legendFormat": "进程数",
            "format": "table",
            "instant": true,
            "range": false
           }
          },
          "refId": "B",
          "hidden": false
         }
        },
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "${DS_PROMETHEUS}"
           },
           "spec": {
            "editorMode": "code",
            "expr": "sum by (name) (rate(lxc_container_cpu_seconds_total[5m]))",
            "legendFormat": "CPU 核数",
            "format": "table",
            "instant": true,
            "range": false
           }
          },
          "refId": "C",
          "hidden": false
         }
        }
       ],
       "transformations": [
        {
         "kind": "Transformation",
         "group": "labelsToFields",
         "spec": {
          "options": {
           "mode": "columns"
          }
         }
        },
        {
         "kind": "Transformation",
         "group": "merge",
         "spec": {
          "options": {}
         }
        },
        {
         "kind": "Transformation",
         "group": "organize",
         "spec": {
          "options": {
           "excludeByName": {
            "Time": true,
            "job": true,
            "instance": true,
            "exported_instance": true
           },
           "renameByName": {
            "name": "容器",
            "Value #A": "内存",
            "Value #B": "进程数",
            "Value #C": "CPU 核数"
           }
          }
         }
        }
       ],
       "queryOptions": {}
      }
     },
     "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.2.2",
      "spec": {
       "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
         {
          "desc": true,
          "displayName": "本月入向"
         }
        ]
       },
       "fieldConfig": {
        "defaults": {
         "unit": "short",
         "thresholds": {
          "mode": "absolute",
          "steps": [
           {
            "value": 0,
            "color": "green"
           }
          ]
         },
         "color": {
          "mode": "thresholds"
         },
         "custom": {
          "align": "auto",
          "cellOptions": {
           "type": "auto"
          },
          "footer": {
           "reducers": [
            "sum"
           ]
          },
          "inspect": false
         }
        },
        "overrides": [
         {
          "matcher": {
           "id": "byName",
           "options": "容器"
          },
          "properties": [
           {
            "id": "unit",
            "value": "string"
           }
          ]
         },
         {
          "matcher": {
           "id": "byName",
           "options": "内存"
          },
          "properties": [
           {
            "id": "unit",
            "value": "bytes"
           }
          ]
         },
         {
          "matcher": {
           "id": "byName",
           "options": "进程数"
          },
          "properties": [
           {
            "id": "unit",
            "value": "short"
           }
          ]
         },
         {
          "matcher": {
           "id": "byName",
           "options": "CPU 核数"
          },
          "properties": [
           {
            "id": "unit",
            "value": "short"
           }
          ]
         }
        ]
       }
      }
     }
    }
   },
