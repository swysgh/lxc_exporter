            "editorMode": "code",
            "expr": "sum(lxc_container_memory_bytes)",
            "legendFormat": "合计",
            "range": true
           }
          },
          "refId": "A",
          "hidden": false
         }
        }
       ],
       "transformations": [],
       "queryOptions": {}
      }
     },
     "vizConfig": {
      "kind": "VizConfig",
      "group": "stat",
      "version": "13.2.2",
